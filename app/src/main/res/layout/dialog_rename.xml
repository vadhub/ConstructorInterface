<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Введите ID:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/renameIDEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:hint="Новый ID"
        android:inputType="text"
        android:maxLength="50"
        android:maxLines="1"
        android:padding="12dp" />

    <TextView
        android:id="@+id/charIDCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="0/50"
        android:textColor="#666666"
        android:textSize="12sp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Введите новый текст:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/renameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:hint="Новый текст"
        android:inputType="text"
        android:maxLength="50"
        android:maxLines="1"
        android:padding="12dp" />

    <TextView
        android:id="@+id/charCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="0/50"
        android:textColor="#666666"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Тип события:"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/eventTypeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/titleTextDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Введите текст диалога:"
        android:textSize="16sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/textEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:hint="Новый текст"
        android:inputType="text"
        android:maxLength="50"
        android:maxLines="1"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/charCountDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="0/50"
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/titleDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Введите заголовок диалога:"
        android:textSize="16sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/textTitleEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:hint="Новый текст"
        android:inputType="text"
        android:maxLength="50"
        android:maxLines="1"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/charCountDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="0/50"
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/titleToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Введите текст тоста:"
        android:textSize="16sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/textToastEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:hint="Новый текст"
        android:inputType="text"
        android:maxLength="50"
        android:maxLines="1"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/charCountToastTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="0/50"
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/mathLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Математическое выражение:"
        android:textSize="16sp"
        tools:visibility="visible"
        android:visibility="gone" />

    <EditText
        android:id="@+id/math_expression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/edit_text_background"
        android:hint="Например: a + b или 2 * 3"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        tools:visibility="visible"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Результат сохранить в:"
        android:textSize="16sp"
        tools:visibility="visible"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/result_tag_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:visibility="visible"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/preview_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Пример: 2 + 3"
        tools:visibility="visible"
        android:textColor="#666666"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>